---
// The main address ("/") sends each visitor to their language:
// 1) the language they picked before, 2) Hebrew if their browser is in Hebrew, 3) otherwise English.
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Discover China</title>
    <script is:inline>
      (function () {
        var supported = ['en', 'he'];
        var lang = null;
        try { lang = localStorage.getItem('dc-lang'); } catch (e) {}
        if (supported.indexOf(lang) === -1) {
          var prefs = navigator.languages || [navigator.language || 'en'];
          lang = 'en';
          for (var i = 0; i < prefs.length; i++) {
            var code = String(prefs[i]).toLowerCase().slice(0, 2);
            if (code === 'he' || code === 'iw') { lang = 'he'; break; }
            if (code === 'en') { break; }
          }
        }
        location.replace('/' + lang + '/');
      })();
    </script>
    <noscript><meta http-equiv="refresh" content="0; url=/en/" /></noscript>
  </head>
  <body style="font-family: system-ui, sans-serif; text-align: center; padding: 40px;">
    <p><a href="/en/">English</a> · <a href="/he/" lang="he">עברית</a></p>
  </body>
</html>
