---
// All destinations: one card per city.
import Base from '../../../layouts/Base.astro';
import T from '../../../components/T.astro';
import { languages, t, type Lang } from '../../../i18n/ui';
import { img, imgSet } from '../../../lib/content';
import cities from '../../../data/cities.json';
import places from '../../../data/places.json';

export function getStaticPaths() {
  return Object.keys(languages).map((lang) => ({ params: { lang } }));
}
const lang = Astro.params.lang as Lang;
---
<Base lang={lang} title={t(lang, 'dest.title')} path="destinations/" section="destinations">
  <h1 class="pt">{t(lang, 'dest.title')}</h1>
  <p class="muted intro">{t(lang, 'dest.intro')}</p>
  <div class="grid">
    {Object.entries(cities).map(([id, c]) => (
      <a class="city card" href={`/${lang}/destinations/${id}/`}>
        <div class="ci"><img src={img(c.images[0])} srcset={imgSet(c.images[0])} sizes="(max-width: 699px) 100vw, 340px" alt="" loading="lazy" width="800" height="500" /></div>
        <div class="cb">
          <h2><bdi lang="en">{c.name}</bdi> <span class="zh" lang="zh">{c.zh}</span></h2>
          <p class="muted">{(places as Record<string, unknown[]>)[id].length} {t(lang, 'dest.places')} · <bdi dir="ltr">{c.weather.temp}</bdi> <T v={c.weather.desc} lang={lang} /></p>
        </div>
      </a>
    ))}
  </div>
</Base>
<style>
  .pt { color: var(--forest); }
  .intro { margin: 8px 0 24px; max-width: 640px; }
  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 16px; }
  .city { overflow: hidden; text-decoration: none; transition: transform .15s; }
  .city:hover { transform: translateY(-2px); }
  .ci { aspect-ratio: 16 / 9; background: var(--sage-l); }
  .ci img { width: 100%; height: 100%; object-fit: cover; }
  .cb { padding: 12px 16px 16px; }
  .cb h2 { font-size: 20px; }
  .cb h2 .zh { color: var(--muted); font-size: 16px; }
  .cb p { margin: 4px 0 0; font-size: 14px; }
</style>
