---
// City page in "Destinations": banner, filters and all places (viewing only, no plan or hotels).
import Base from '../../../../layouts/Base.astro';
import CityTabs from '../../../../components/CityTabs.astro';
import PlaceCard from '../../../../components/PlaceCard.astro';
import T from '../../../../components/T.astro';
import { languages, t, type Lang, type UIKey } from '../../../../i18n/ui';
import { img, imgSet, credit } from '../../../../lib/content';
import cities from '../../../../data/cities.json';
import places from '../../../../data/places.json';

export function getStaticPaths() {
  return Object.keys(languages).flatMap((lang) => Object.keys(cities).map((city) => ({ params: { lang, city } })));
}
const lang = Astro.params.lang as Lang;
const id = Astro.params.city as keyof typeof cities;
const c = cities[id];
const list = (places as Record<string, any[]>)[id];
const must = new Set(c.mustSee);
const cats = ['sight', 'nature', 'fun', 'food', 'taste'].filter((k) => list.some((p) => p.cat === k));
const banner = c.images[0];
const cr = credit(banner);
// Must-see places first, then the rest in their original order.
const sorted = [...list.filter((p) => must.has(p.name)), ...list.filter((p) => !must.has(p.name))];
---
<Base lang={lang} title={c.name} path={`destinations/${id}/`} section="destinations">
  <CityTabs lang={lang} active={id} />

  <section class="cityban">
    <img src={img(banner)} srcset={imgSet(banner)} sizes="(max-width: 899px) 100vw, 1020px" alt={c.name} fetchpriority="high" width="1600" height="900" />
    <div class="cb-text">
      <h1><bdi lang="en">{c.name}</bdi> <span class="zh" lang="zh">{c.zh}</span></h1>
      <p class="cbwx">{t(lang, 'dest.weather')} · <bdi dir="ltr">{c.weather.temp}</bdi> · <T v={c.weather.desc} lang={lang} /></p>
    </div>
    {cr && <a class="cbcr" href={cr.href} target="_blank" rel="noopener">{t(lang, 'common.photo')}: <bdi>{cr.text}</bdi></a>}
  </section>

  {lang === 'en' && <p class="tr-note">{t(lang, 'common.translating')}</p>}

  <h2 class="see">{t(lang, 'dest.see')}<bdi lang="en">{c.name}</bdi></h2>
  <div class="filters" role="group">
    <button type="button" class="f on" data-f="all" aria-pressed="true">{t(lang, 'dest.all')} <span>{list.length}</span></button>
    <button type="button" class="f" data-f="must" aria-pressed="false">{t(lang, 'dest.must')} <span>{must.size}</span></button>
    {cats.map((k) => (
      <button type="button" class="f" data-f={k} aria-pressed="false">{t(lang, `cat.${k}` as UIKey)} <span>{list.filter((p) => p.cat === k).length}</span></button>
    ))}
  </div>

  <div class="cards">
    {sorted.map((p) => <PlaceCard p={p} lang={lang} must={must.has(p.name)} cityName={c.name} cityZh={c.zh} />)}
  </div>
  <p class="empty muted" hidden>{t(lang, 'dest.empty')}</p>
</Base>

<script>
  // Filters
  const btns = document.querySelectorAll<HTMLButtonElement>('.filters .f');
  const cards = document.querySelectorAll<HTMLElement>('.cards .pcard');
  const empty = document.querySelector<HTMLElement>('.empty');
  btns.forEach((b) => b.addEventListener('click', () => {
    const f = b.dataset.f;
    btns.forEach((x) => { x.classList.toggle('on', x === b); x.setAttribute('aria-pressed', String(x === b)); });
    let shown = 0;
    cards.forEach((c) => {
      const ok = f === 'all' || (f === 'must' ? c.dataset.must === '1' : c.dataset.cat === f);
      c.hidden = !ok; if (ok) shown++;
    });
    if (empty) empty.hidden = shown > 0;
  }));
  // Copy Chinese names
  document.addEventListener('click', async (e) => {
    const b = (e.target as HTMLElement).closest<HTMLButtonElement>('.cp');
    if (!b) return;
    try { await navigator.clipboard.writeText(b.dataset.cp || ''); } catch {}
    b.classList.add('ok'); b.textContent = '✓';
    setTimeout(() => { b.classList.remove('ok'); b.textContent = '⧉'; }, 1200);
  });
</script>

<style>
  .cityban { position: relative; border-radius: 20px; overflow: hidden; box-shadow: var(--shadow); background: var(--sage); }
  .cityban img { width: 100%; height: clamp(200px, 34vw, 320px); object-fit: cover; }
  .cityban::after { content: ''; position: absolute; inset: 0; background: linear-gradient(0deg, rgba(0,0,0,.55), transparent 55%); }
  .cb-text { position: absolute; inset-inline: 20px; bottom: 16px; z-index: 1; color: #fff; }
  .cb-text h1 { color: #fff; text-shadow: 0 2px 10px rgba(0,0,0,.35); }
  .cb-text h1 .zh { font-size: .6em; opacity: .9; }
  .cbwx { margin: 4px 0 0; font-size: 14px; opacity: .92; text-shadow: 0 1px 6px rgba(0,0,0,.4); }
  .cbcr { position: absolute; top: 10px; inset-inline-end: 10px; z-index: 1; font-size: 12px; color: #fff; text-decoration: none;
    background: rgba(20,20,20,.45); padding: 3px 10px; border-radius: 999px; }
  .tr-note { margin: 12px 0 0; font-size: 14px; color: var(--muted); }
  .see { margin: 28px 0 12px; font-size: 24px; }
  .filters { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 16px; }
  .f { min-height: 36px; padding: 0 14px; border-radius: 999px; border: 0; background: var(--card); box-shadow: var(--shadow);
    color: var(--ink); font-weight: 700; font-size: 14px; cursor: pointer; }
  .f span { color: var(--muted); font-weight: 600; margin-inline-start: 2px; }
  .f.on { background: var(--forest); color: var(--on-forest); }
  .f.on span { color: inherit; opacity: .8; }
  .cards { display: grid; grid-template-columns: repeat(auto-fill, minmax(290px, 1fr)); gap: 16px; align-items: start; }
  @media (max-width: 899px) { .filters { flex-wrap: nowrap; overflow-x: auto; padding-bottom: 6px; } .f { flex: none; } }
</style>
