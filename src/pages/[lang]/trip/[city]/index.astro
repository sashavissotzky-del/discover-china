---
// City page inside "My trip": day by day, where to stay, and moving on along the route.
// Built for every city; the browser marks which days belong to the visitor's route and fills in dates.
import Base from '../../../../layouts/Base.astro';
import T from '../../../../components/T.astro';
import { languages, t, type Lang } from '../../../../i18n/ui';
import { img, imgSet, credit, tx, noEmoji, type Text } from '../../../../lib/content';
import { gm, am } from '../../../../lib/maps';
import cities from '../../../../data/cities.json';
import places from '../../../../data/places.json';
import dayplans from '../../../../data/dayplans.json';
import dayroutes from '../../../../data/day-routes.json';
import hotels from '../../../../data/hotels.json';
import practical from '../../../../data/practical.json';
import settings from '../../../../data/settings.json';
import routes from '../../../../data/routes.json';
import { cnHolidayDates } from '../../../../lib/closures';

export function getStaticPaths() {
  return Object.keys(languages).flatMap((lang) => Object.keys(cities).map((city) => ({ params: { lang, city } })));
}
const lang = Astro.params.lang as Lang;
const id = Astro.params.city as keyof typeof cities;
const C = cities as Record<string, { name: string; zh: string; color: string; images: string[]; hotelArea: Text }>;
const c = C[id];

type Stop = { cat: Text; slot: Text; n: string; z: string; g?: string; dur: Text; d: Text; tip?: Text; tr?: Text; hotel?: number; v?: string;
  hl?: [string, string, Text][]; hlT?: Text };
type Day = { id: string; tab: Text; title: Text; anchors: Text[]; book: Text[]; stops: Stop[]; extra?: Text; variants?: [string, Text][] };
const days = (dayplans as Record<string, { days: Day[] }>)[id].days;
const droutes = (dayroutes as Record<string, { label: Text; stops: string[]; mode: string }[]>)[id] || [];
const P = (places as Record<string, { name: string; img: string }[]>)[id];
const stopImg: Record<string, string> = settings.stopImages;
const imgFor = (s: Stop) => stopImg[s.n] || P.find((p) => p.name === s.n)?.img || '';
type PR = { hours: Text; booking: Text; advice: Text; source: string | null; checked: string | null; closedMonday?: number };
const PRm = practical as Record<string, PR>;
const H = (hotels as Record<string, Record<string, { label: Text; name: string; rating: Text; price: Text; url: string; mapQuery: string }[]>>)[id];
const tiers = ['budget', 'recommended', 'luxury'].filter((k) => H[k]?.length);
const banner = c.images[0];
const cr = credit(banner);
// Google Maps link for a whole day (from the day-routes list; HOTEL = the main street as a stand-in)
const anchor = (cities as any)[id].mainStreet as string;
const dayRouteUrl = (i: number) => {
  const r = droutes[i];
  if (!r) return '';
  const pts = r.stops.map((s) => (s === 'HOTEL' ? anchor : s));
  const w = pts.slice(1, -1);
  return `https://www.google.com/maps/dir/?api=1&origin=${encodeURIComponent(pts[0])}&destination=${encodeURIComponent(pts[pts.length - 1])}${w.length ? `&waypoints=${encodeURIComponent(w.join('|'))}` : ''}&travelmode=${r.mode || 'walking'}`;
};
const routeData = (routes as any[]).map((r) => ({ id: r.id, name: tx(r.name, lang), col: r.col, s12: r.s12, s14: r.s14 }));
const cityData = Object.fromEntries(Object.entries(C).map(([k, v]) => [k, { name: v.name, color: v.color }]));
---
<Base lang={lang} title={`${c.name} · ${t(lang, 'trip.title')}`} path={`trip/${id}/`} section="trip">
  <nav class="crumbs small">
    <a href={`/${lang}/trip/`}>{t(lang, 'arrow.back')} {t(lang, 'tc.back')}</a>
    <span class="muted" id="cityOf"></span>
  </nav>

  <section class="cityban">
    <img src={img(banner)} srcset={imgSet(banner)} sizes="(max-width: 899px) 100vw, 1020px" alt={c.name} width="1600" height="900" fetchpriority="high" />
    <div class="cb-text">
      <h1><span class="cnum" id="cnum" style={`--cc:${c.color}`} hidden></span><bdi lang="en">{c.name}</bdi> <span class="zh" lang="zh">{c.zh}</span></h1>
      <p class="cbsub" id="cbsub"></p>
    </div>
    {cr && <a class="cbcr" href={cr.href} target="_blank" rel="noopener">{t(lang, 'common.photo')}: <bdi>{cr.text}</bdi></a>}
  </section>

  <p class="notmine card" id="notMine" hidden>
    {t(lang, 'tc.notMine').replace('{x}', c.name)} <a href={`/${lang}/destinations/${id}/`}>{t(lang, 'tc.allPlaces')}<bdi lang="en">{c.name}</bdi> {t(lang, 'arrow.fwd')}</a>
  </p>
  {lang === 'en' && <p class="muted small">{t(lang, 'common.translating')}</p>}

  <h2 class="sec">{t(lang, 'tc.days')}</h2>
  <div class="dtabs" role="tablist">
    {days.map((d, i) => (
      <button type="button" role="tab" class="dtab" data-day={d.id} data-x={d.id.startsWith('x') ? '1' : undefined} aria-selected={i === 0 ? 'true' : 'false'}>
        <T v={d.tab} lang={lang} strip /><span class="ddate"></span>
      </button>
    ))}
    <button type="button" class="dmore" hidden></button>
  </div>

  {days.map((d, i) => (
    <section class="dpanel card" data-day={d.id} hidden={i !== 0}>
      <p class="notin small" hidden>{t(lang, 'tc.notInRoute')}</p>
      <div class="dwarn" hidden data-closed={JSON.stringify([...new Set(d.stops.filter((x) => PRm[x.n]?.closedMonday).map((x) => x.n))])}>
        <b></b><span class="small">{t(lang, 'warn.hint')}</span>
      </div>
      <T v={d.title} lang={lang} as="h3" class="dtitle" strip />
      {d.extra && <T v={d.extra} lang={lang} as="p" class="dextra small" strip />}
      {(d.anchors.length > 0 || d.book.length > 0) && (
        <ul class="facts small">
          {d.anchors.map((a) => <T v={a} lang={lang} as="li" strip />)}
          {d.book.map((b) => <li class="bk"><b>{t(lang, 'tc.book')}:</b> <T v={b} lang={lang} strip /></li>)}
        </ul>
      )}
      {d.variants && (
        <div class="vars" role="group">
          {d.variants.map(([v, label], k) => <button type="button" class={`vb${k === 0 ? ' on' : ''}`} data-v={v}><T v={label} lang={lang} strip /></button>)}
        </div>
      )}
      <ol class="stops">
        {d.stops.map((s, k) => {
          const pic = imgFor(s);
          const pr = PRm[s.n];
          return (
            <li class="stop" data-v={s.v} hidden={!!d.variants && !!s.v && s.v !== d.variants[0][0]}>
              <details>
                <summary>
                  <span class="sn">{k + 1}</span>
                  <span class="sp">{pic ? <img src={img(pic, true)} alt="" loading="lazy" width="320" height="213" /> : <i class="noimg" aria-hidden="true"></i>}</span>
                  <span class="st">
                    <b>{s.hotel ? t(lang, 'tc.hotel') : <bdi lang="en">{s.n}</bdi>}</b>{s.z && <span class="zh" lang="zh"> {s.z}</span>}
                    <span class="sm small muted"><T v={s.cat} lang={lang} strip />{s.dur && <> · <T v={s.dur} lang={lang} strip /></>}</span>
                    <T v={s.slot} lang={lang} class="sslot small" strip />
                    {pr?.closedMonday && <span class="ctag">{t(lang, 'warn.tag')}</span>}
                  </span>
                  <i class="chev" aria-hidden="true"></i>
                </summary>
                <div class="sb">
                  <T v={s.d} lang={lang} as="p" strip />
                  {s.hl && (
                    <div class="hl"><b>{s.hlT ? <T v={s.hlT} lang={lang} strip /> : t(lang, 'tc.highlights')}</b>
                      <ul>{s.hl.map(([n, z, txt]) => <li><b><bdi lang="en">{n}</bdi></b>{z && <span class="zh" lang="zh"> {z}</span>} · <T v={txt} lang={lang} strip /></li>)}</ul>
                    </div>
                  )}
                  {s.tip && <T v={s.tip} lang={lang} as="p" class="tip small" strip />}
                  {pr && (
                    <div class="prac small">
                      {pr.hours && <p><b>{t(lang, 'dest.hours')}:</b> <T v={pr.hours} lang={lang} /></p>}
                      {pr.booking && <p><b>{t(lang, 'dest.tickets')}:</b> <T v={pr.booking} lang={lang} /></p>}
                      {pr.source && <p class="muted">{t(lang, 'dest.source')}: <a href={pr.source} target="_blank" rel="noopener">{new URL(pr.source).hostname.replace(/^www\./, '')}</a>{pr.checked && <> · {t(lang, 'dest.checked')} <bdi dir="ltr">{pr.checked}</bdi></>}</p>}
                    </div>
                  )}
                  {!s.hotel && (
                    <div class="acts">
                      {s.z && <a class="btn" href={am(s.z, c.zh)} target="_blank" rel="noopener">Amap 高德</a>}
                      <a class="btn" href={gm(s.g || `${s.n}, ${c.name}`)} target="_blank" rel="noopener">Google Maps</a>
                    </div>
                  )}
                </div>
              </details>
              {s.tr && <T v={s.tr} lang={lang} as="p" class="tr small" strip />}
            </li>
          );
        })}
      </ol>
      {dayRouteUrl(i) && !d.id.startsWith('x') && <a class="dayroute small" href={dayRouteUrl(days.filter((x) => !x.id.startsWith('x')).indexOf(d))} target="_blank" rel="noopener">{t(lang, 'tc.dayRoute')} {t(lang, 'arrow.fwd')}</a>}
    </section>
  ))}

  <h2 class="sec">{t(lang, 'tc.sleep')}</h2>
  <section class="card sleep">
    <T v={c.hotelArea} lang={lang} as="p" class="area" />
    <div class="seg" role="group" aria-label={t(lang, 'tc.sleep')}>
      {tiers.map((k) => <button type="button" data-tier={k} class={k === 'recommended' ? 'on' : ''}>{t(lang, `tc.${k}` as any)}</button>)}
    </div>
    {tiers.map((k) => (
      <div class="hlist" data-tier={k} hidden={k !== 'recommended'}>
        {H[k].map((h) => (
          <article class="hotel">
            <T v={h.label} lang={lang} as="p" class="hlabel small" />
            <h3><bdi lang="en">{h.name}</bdi></h3>
            <T v={h.rating} lang={lang} as="p" class="small muted" />
            <T v={h.price} lang={lang} as="p" class="hprice" />
            <div class="acts">
              <a class="btn pri" href={h.url} target="_blank" rel="noopener">{t(lang, 'tc.bookIt')}</a>
              <a class="btn" href={gm(h.mapQuery || h.name)} target="_blank" rel="noopener">Google Maps</a>
            </div>
          </article>
        ))}
      </div>
    ))}
    <p class="small muted">{t(lang, 'tc.prices')}</p>
  </section>

  <section class="card cont" id="cont" hidden>
    <h2>{t(lang, 'tc.continue')}</h2>
    <div class="pn" id="pn"></div>
  </section>

  <script type="application/json" id="tcData" set:html={JSON.stringify({ id, lang, routes: routeData, cities: cityData,
    txt: { cityOf: t(lang, 'tc.cityOf'), more: t(lang, 'tc.more'), nights: t(lang, 'routes.nights'), night: t(lang, 'routes.night'),
      next: t(lang, 'tc.next'), prev: t(lang, 'tc.prev'), fwd: t(lang, 'arrow.fwd'), back: t(lang, 'arrow.back'),
      closed: t(lang, 'warn.closed'), monday: lang === 'he' ? 'יום שני' : 'Monday' }, cnHol: cnHolidayDates() })} />
</Base>

<script>
  import { getTrip, getLen } from '../../../../scripts/trip-store';
  const D = JSON.parse(document.getElementById('tcData')!.textContent!);
  const $ = (s: string) => document.querySelector<HTMLElement>(s)!;
  const esc = (s: string) => s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]!));
  const parse = (s: string) => { const [y, m, d] = s.split('-').map(Number); return Date.UTC(y, m - 1, d); };
  const short = (t: number) => { const d = new Date(t); return `${d.getUTCDate()}.${d.getUTCMonth() + 1}`; };
  const add = (t: number, n: number) => t + n * 86400000;

  const tabs = [...document.querySelectorAll<HTMLButtonElement>('.dtab')];
  const panels = [...document.querySelectorAll<HTMLElement>('.dpanel')];
  const showDay = (dayId: string) => {
    tabs.forEach((b) => b.setAttribute('aria-selected', String(b.dataset.day === dayId)));
    panels.forEach((p) => (p.hidden = p.dataset.day !== dayId));
  };
  tabs.forEach((b) => b.addEventListener('click', () => showDay(b.dataset.day!)));

  // Variants within a day (e.g. with or without the evening show)
  document.querySelectorAll<HTMLElement>('.vars').forEach((g) => g.querySelectorAll<HTMLButtonElement>('.vb').forEach((b) => b.addEventListener('click', () => {
    g.querySelectorAll('.vb').forEach((x) => x.classList.toggle('on', x === b));
    g.closest('.dpanel')!.querySelectorAll<HTMLElement>('.stop[data-v]').forEach((s) => (s.hidden = s.dataset.v !== b.dataset.v));
  })));

  // Hotel tiers
  document.querySelectorAll<HTMLButtonElement>('.sleep .seg button').forEach((b) => b.addEventListener('click', () => {
    document.querySelectorAll('.sleep .seg button').forEach((x) => x.classList.toggle('on', x === b));
    document.querySelectorAll<HTMLElement>('.hlist').forEach((l) => (l.hidden = l.dataset.tier !== b.dataset.tier));
  }));

  // Route-aware parts: which days belong to the chosen route, dates, city number, previous / next city
  const trip = getTrip();
  const r = D.routes.find((x: any) => x.id === trip.route);
  const stops: [string, number][] = r ? (getLen() === '12' ? r.s12 : r.s14) : [];
  const idx = stops.findIndex(([c]) => c === D.id);
  const regular = tabs.filter((b) => !b.dataset.x);
  let inRoute = regular;
  if (idx >= 0) {
    const nights = stops[idx][1];
    inRoute = regular.slice(0, nights);
    $('#cityOf').textContent = '· ' + D.txt.cityOf.replace('{n}', idx + 1).replace('{m}', stops.length);
    const num = $('#cnum'); num.textContent = String(idx + 1); num.hidden = false;
    let off = 0; for (let k = 0; k < idx; k++) off += stops[k][1];
    const start = trip.start ? add(parse(trip.start), off) : null;
    $('#cbsub').innerHTML = (start != null ? `<bdi dir="ltr">${short(start)}–${short(add(start, nights))}</bdi> · ` : '') + `${nights} ${nights === 1 ? D.txt.night : D.txt.nights}`;
    if (start != null) inRoute.forEach((b, k) => {
      const dt = add(start, k);
      b.querySelector('.ddate')!.textContent = ' · ' + short(dt);
      // Closing-day warning: a place in this day is closed on Mondays (unless it is a holiday in China)
      const panel = panels.find((p) => p.dataset.day === b.dataset.day)!;
      const w = panel.querySelector<HTMLElement>('.dwarn')!;
      const closed: string[] = JSON.parse(w.dataset.closed || '[]');
      const isoDay = new Date(dt).toISOString().slice(0, 10);
      if (new Date(dt).getUTCDay() === 1 && closed.length && !D.cnHol.includes(isoDay)) {
        b.classList.add('warn');
        w.querySelector('b')!.textContent = '⚠ ' + closed.map((n) => D.txt.closed.replace('{p}', n)).join(' · ') + ` · ${short(dt)}, ${D.txt.monday}`;
        w.hidden = false;
      }
    });
    // previous / next
    const card = (k: number, label: string) => {
      const [c, n] = stops[k]; const ci = D.cities[c];
      return `<a class="pnc" href="/${D.lang}/trip/${c}/" style="--cc:${ci.color}"><span class="small">${label}</span><b><bdi lang="en">${esc(ci.name)}</bdi></b><span class="small">${n} ${n === 1 ? D.txt.night : D.txt.nights}</span></a>`;
    };
    $('#pn').innerHTML = (idx > 0 ? card(idx - 1, `${D.txt.back} ${D.txt.prev}`) : '') + (idx < stops.length - 1 ? card(idx + 1, `${D.txt.next} ${D.txt.fwd}`) : '');
    $('#cont').hidden = false;
  } else {
    $('#notMine').hidden = false;
  }
  // Days outside the route are folded behind "N more days"
  const extra = tabs.filter((b) => !inRoute.includes(b));
  const more = $('.dmore') as HTMLButtonElement;
  if (idx >= 0 && extra.length) {
    extra.forEach((b) => { b.hidden = true; b.classList.add('xt'); });
    panels.filter((p) => !inRoute.some((b) => b.dataset.day === p.dataset.day)).forEach((p) => (p.querySelector<HTMLElement>('.notin')!.hidden = false));
    more.hidden = false; more.textContent = D.txt.more.replace('{n}', extra.length) + ' ▾';
    more.addEventListener('click', () => { extra.forEach((b) => (b.hidden = false)); more.hidden = true; });
  }
  showDay((inRoute[0] || tabs[0]).dataset.day!);
</script>

<style>
  .crumbs { display: flex; gap: 8px; align-items: center; margin-bottom: 10px; }
  .crumbs a { color: var(--forest); font-weight: 700; text-decoration: none; }
  .cityban { position: relative; border-radius: 20px; overflow: hidden; box-shadow: var(--shadow); background: var(--sage); }
  .cityban img { width: 100%; height: clamp(180px, 30vw, 280px); object-fit: cover; }
  .cityban::after { content: ''; position: absolute; inset: 0; background: linear-gradient(0deg, rgba(0,0,0,.55), transparent 55%); }
  .cb-text { position: absolute; inset-inline: 20px; bottom: 14px; z-index: 1; color: #fff; }
  .cb-text h1 { color: #fff; display: flex; align-items: center; gap: 10px; flex-wrap: wrap; text-shadow: 0 2px 10px rgba(0,0,0,.35); }
  .cb-text h1 .zh { font-size: .6em; opacity: .9; }
  .cnum { width: 40px; height: 40px; border-radius: 50%; display: inline-grid; place-items: center; background: var(--cc); font: 700 20px var(--f-head); border: 3px solid #fff; text-shadow: none; }
  .cbsub { margin: 4px 0 0; font-size: 14px; opacity: .92; }
  .cbcr { position: absolute; top: 10px; inset-inline-end: 10px; z-index: 1; font-size: 12px; color: #fff; text-decoration: none; background: rgba(20,20,20,.45); padding: 3px 10px; border-radius: 999px; }
  .notmine { padding: 12px 16px; margin: 12px 0 0; }
  .notmine a { color: var(--forest); font-weight: 700; }
  .sec { margin: 28px 0 10px; font-size: 24px; }

  .dtabs { display: flex; gap: 8px; overflow-x: auto; padding: 2px 2px 10px; }
  .dtab, .dmore { flex: none; min-height: 40px; padding: 0 14px; border-radius: 999px; border: 0; background: var(--card); box-shadow: var(--shadow); color: var(--ink); font: 700 14px var(--f-body); cursor: pointer; }
  .dtab[aria-selected='true'] { background: var(--forest); color: var(--on-forest); }
  .dtab.xt { border: 2px dashed var(--sage); }
  .dmore { color: var(--forest); background: var(--sage-l); box-shadow: none; }
  .ddate { opacity: .75; font-weight: 600; }
  .dpanel { padding: 16px; }
  .dtab.warn { box-shadow: inset 0 0 0 2px var(--terra-solid); }
  .dtab.warn::after { content: ' ⚠'; color: var(--terra-ink); }
  .dtab.warn[aria-selected='true']::after { color: inherit; }
  .dwarn { margin: 0 0 12px; background: var(--terra-solid); color: #fff; padding: 10px 12px; border-radius: 10px; display: grid; gap: 2px; }
  .ctag { justify-self: start; font-size: 11px; font-weight: 700; color: var(--terra-ink); background: var(--terra-l); padding: 1px 8px; border-radius: 999px; }
  .notin { margin: 0 0 8px; background: var(--terra-l); color: var(--terra-ink); padding: 6px 10px; border-radius: 8px; font-weight: 700; }
  .dtitle { font-size: 20px; }
  .dextra { margin: 6px 0 0; color: var(--muted); }
  .facts { list-style: none; padding: 0; margin: 10px 0 0; display: grid; gap: 4px; }
  .facts li { padding-inline-start: 14px; position: relative; }
  .facts li::before { content: ''; position: absolute; inset-inline-start: 0; top: .6em; width: 6px; height: 6px; border-radius: 50%; background: var(--sage); }
  .facts .bk b { color: var(--terra-ink); }
  .vars { display: flex; flex-wrap: wrap; gap: 6px; margin-top: 12px; }
  .vb { min-height: 36px; padding: 0 12px; border-radius: 999px; border: 0; background: var(--sage-l); color: var(--forest); font: 700 13px var(--f-body); cursor: pointer; }
  .vb.on { background: var(--forest); color: var(--on-forest); }

  .stops { list-style: none; padding: 0; margin: 14px 0 0; display: grid; gap: 0; }
  .stop details { background: var(--bg); border-radius: 14px; }
  .stop summary { list-style: none; cursor: pointer; display: flex; align-items: center; gap: 10px; padding: 8px; }
  .stop summary::-webkit-details-marker { display: none; }
  .sn { flex: none; width: 26px; height: 26px; border-radius: 50%; display: grid; place-items: center; background: var(--forest); color: var(--on-forest); font: 700 13px var(--f-head); }
  .sp { flex: none; width: 72px; height: 56px; border-radius: 10px; overflow: hidden; background: var(--sage-l); }
  .sp img { width: 100%; height: 100%; object-fit: cover; }
  .noimg { display: block; width: 100%; height: 100%; background: var(--sage-l); }
  .st { flex: 1; min-width: 0; display: grid; gap: 1px; }
  .st .zh { color: var(--muted); font-size: 14px; }
  .sslot { color: var(--forest); font-weight: 700; }
  .chev { width: 8px; height: 8px; border-right: 2px solid var(--muted); border-bottom: 2px solid var(--muted); transform: rotate(45deg); margin: 0 6px 4px; flex: none; }
  details[open] > summary .chev { transform: rotate(-135deg); margin-bottom: -2px; }
  .sb { padding: 0 12px 12px; display: grid; gap: 8px; }
  .sb p { margin: 0; }
  .hl ul { margin: 4px 0 0; padding-inline-start: 18px; font-size: 14px; display: grid; gap: 4px; }
  .hl > b { color: var(--forest); font-size: 14px; }
  .tip { background: var(--card); padding: 8px 10px; border-radius: 10px; }
  .prac p { margin: 2px 0; } .prac b { color: var(--forest); }
  .acts { display: flex; flex-wrap: wrap; gap: 8px; }
  .btn { min-height: 36px; display: inline-flex; align-items: center; padding: 0 14px; border-radius: 999px; background: var(--sage-l); color: var(--forest); text-decoration: none; font-weight: 700; font-size: 14px; }
  .btn.pri { background: var(--forest); color: var(--on-forest); }
  .tr { margin: 0; padding: 6px 0 6px 0; padding-inline-start: 20px; color: var(--muted); border-inline-start: 3px dashed var(--sage); margin-inline-start: 20px; }
  .stop:not(:last-child):not(:has(.tr)) { margin-bottom: 8px; }
  .dayroute { display: inline-block; margin-top: 12px; color: var(--forest); font-weight: 700; text-decoration: none; }

  .sleep { padding: 16px; display: grid; gap: 12px; }
