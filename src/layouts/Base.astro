---
// The frame shared by every page: language, text direction, header and footer.
import { languages, t, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
  title?: string;
  /** Path after the language prefix, e.g. "" for home or "destinations/beijing" */
  path?: string;
}

const { lang, title, path = '' } = Astro.props;
const dir = languages[lang].dir;
const pageTitle = title ? `${title} · Discover China` : t(lang, 'site.title');
const base = Astro.url.origin;
---
<!doctype html>
<html lang={lang} dir={dir}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={t(lang, 'site.description')} />
    {Object.keys(languages).map((l) => (
      <link rel="alternate" hreflang={l} href={`${base}/${l}/${path}`} />
    ))}
    <link rel="alternate" hreflang="x-default" href={`${base}/`} />
    <style is:global>
      :root {
        --cream: #F7F5EF; --ink: #343A36; --forest: #34483E;
        --sage: #879B82; --sage-text: #5F7359; --terracotta: #C77B61; --card: #FFFFFF;
      }
      * { box-sizing: border-box; }
      body {
        margin: 0; background: var(--cream); color: var(--ink); line-height: 1.6;
        font-family: system-ui, -apple-system, "Segoe UI", Roboto, Arial, sans-serif;
      }
      a { color: inherit; }
      .wrap { max-width: 960px; margin: 0 auto; padding: 0 24px; }
      .zh { font-family: "Noto Serif SC", "Songti SC", serif; }
    </style>
  </head>
  <body>
    <header class="wrap site-header">
      <a class="logo" href={`/${lang}/`}>Discover <span>China</span></a>
      <nav class="lang-switch" aria-label={t(lang, 'lang.switch')}>
        {Object.entries(languages).map(([code, info]) => (
          <a
            href={`/${code}/${path}`}
            hreflang={code}
            lang={code}
            class={code === lang ? 'active' : ''}
            aria-current={code === lang ? 'true' : undefined}
            data-lang={code}
          >{info.short}</a>
        ))}
      </nav>
    </header>

    <main class="wrap">
      <slot />
    </main>

    <footer class="wrap site-footer"><bdi dir="ltr">© {new Date().getFullYear()} Discover China</bdi></footer>

    <script>
      // Remember the language the visitor picks, so the main address opens it next time.
      document.querySelectorAll<HTMLAnchorElement>('.lang-switch a').forEach((a) => {
        a.addEventListener('click', () => {
          try { localStorage.setItem('dc-lang', a.dataset.lang || ''); } catch {}
        });
      });
    </script>

    <style>
      .site-header { display: flex; align-items: center; justify-content: space-between; padding-top: 20px; padding-bottom: 20px; }
      .logo { font-weight: 700; font-size: 1.25rem; color: var(--forest); text-decoration: none; }
      .logo span { color: var(--terracotta); }
      .lang-switch { display: flex; gap: 4px; background: var(--card); padding: 4px; border-radius: 999px; box-shadow: 0 2px 10px rgba(0,0,0,.05); }
      .lang-switch a { padding: 6px 14px; border-radius: 999px; text-decoration: none; font-size: .9rem; font-weight: 600; color: var(--sage-text); }
      .lang-switch a.active { background: var(--forest); color: #fff; }
      .site-footer { text-align: center; padding-top: 40px; padding-bottom: 40px; color: var(--sage-text); font-size: .9rem; }
    </style>
  </body>
</html>
