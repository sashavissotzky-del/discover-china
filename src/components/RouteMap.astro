---
// Map of one route: light China map + lines between cities (style by transport) + numbered city dots.
import cities from '../data/cities.json';
import transport from '../data/transport.json';
import type { Lang } from '../i18n/ui';

interface Props { stops: string[]; legs: string[]; label: string; lang: Lang }
const { stops, legs, label } = Astro.props;
const C = cities as Record<string, { name: string; map: { x: number; y: number; dx: number; dy: number; anchor: string }; color: string }>;
const L = transport.legs as Record<string, { from: string; to: string; intl?: number; modes: { m: string; rec?: number }[] }>;
const color: Record<string, string> = { flight: '#9E5238', train: '#34483E', boat: '#467495', car: '#467495' };

const lines = legs
  .map((id) => L[id])
  .filter((l) => l && !l.intl && C[l.from] && C[l.to])
  .map((l) => {
    const m = (l.modes.find((x) => x.rec) || l.modes[0]).m;
    const a = C[l.from].map, b = C[l.to].map;
    // a gentle curve, so flights and train lines don't overlap with straight edges
    const mx = (a.x + b.x) / 2 - (b.y - a.y) * 0.12, my = (a.y + b.y) / 2 + (b.x - a.x) * 0.12;
    return { d: `M${a.x},${a.y} Q${mx},${my} ${b.x},${b.y}`, m };
  });
---
<div class="rmap" role="img" aria-label={label}>
  <img src="/map/china.svg" alt="" width="760" height="760" loading="lazy" />
  <svg viewBox="0 0 760 760" aria-hidden="true">
    {lines.map((l) => (
      <path d={l.d} fill="none" stroke={color[l.m]} stroke-width="4" stroke-linecap="round"
        stroke-dasharray={l.m === 'flight' ? '2 9' : l.m === 'train' ? undefined : '10 6'} />
    ))}
    {Object.entries(C).filter(([id]) => !stops.includes(id)).map(([, c]) => (
      <circle cx={c.map.x} cy={c.map.y} r="5" fill="#B9B3A4" />
    ))}
    {stops.map((id, i) => {
      const c = C[id];
      return (
        <g>
          <circle cx={c.map.x} cy={c.map.y} r="12" fill={c.color} stroke="#fff" stroke-width="3" />
          <text x={c.map.x} y={c.map.y + 4.5} text-anchor="middle" class="n">{i + 1}</text>
          <text x={c.map.x + c.map.dx * 1.6} y={c.map.y + c.map.dy * 1.6 + 4} text-anchor={c.map.anchor} class="lbl">{c.name}</text>
        </g>
      );
    })}
  </svg>
</div>
<style>
  .rmap { position: relative; aspect-ratio: 1; background: #F3F0E8; border-radius: var(--radius); overflow: hidden; }
  .rmap img, .rmap svg { position: absolute; inset: 0; width: 100%; height: 100%; }
  .n { fill: #fff; font: 700 13px var(--f-head); }
  .lbl { fill: #343A36; font: 700 17px var(--f-body); paint-order: stroke; stroke: #F3F0E8; stroke-width: 4px; }
  @media (prefers-color-scheme: dark) { .rmap img { filter: brightness(.9); } }
</style>
