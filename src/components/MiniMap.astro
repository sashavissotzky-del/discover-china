---
// Small static map of a whole route, for the side-by-side comparison (like .mcard in the dashboard).
import cities from '../data/cities.json';
import transport from '../data/transport.json';

interface Props { stops: string[]; legs: string[] }
const { stops, legs } = Astro.props;
type City = { name: string; map: { x: number; y: number; dx: number; dy: number; anchor: string } };
const C = cities as Record<string, City>;
const L = transport.legs as Record<string, { from: string; to: string; intl?: number; modes: { m: string; rec?: number }[] }>;
const color: Record<string, string> = { flight: '#9E5238', train: '#34483E', boat: '#467495', car: '#467495' };
const dash: Record<string, string | undefined> = { flight: '6 6', train: undefined, boat: '8 5', car: '8 5' };

const lines = legs.map((k) => L[k]).filter((l) => l && !l.intl).map((l) => {
  const m = (l.modes.find((x) => x.rec) || l.modes[0]).m;
  const a = C[l.from].map, b = C[l.to].map;
  const mx = (a.x + b.x) / 2 - (b.y - a.y) * 0.12, my = (a.y + b.y) / 2 + (b.x - a.x) * 0.12;
  return { d: `M${a.x},${a.y} Q${mx},${my} ${b.x},${b.y}`, m };
});
const xs = stops.map((s) => C[s].map.x), ys = stops.map((s) => C[s].map.y);
// 4:3 view around all stops (with room for names), kept inside the map
const W = (Math.max(320, Math.max(...xs) - Math.min(...xs) + 190, (Math.max(...ys) - Math.min(...ys) + 110) * 4 / 3));
const H = W * 3 / 4;
const cx = (Math.min(...xs) + Math.max(...xs)) / 2, cy = (Math.min(...ys) + Math.max(...ys)) / 2;
// stay inside the map when the view fits; otherwise centre it (the edge is just empty background)
const x0 = W <= 760 ? Math.max(0, Math.min(760 - W, cx - W / 2)) : cx - W / 2;
const y0 = H <= 760 ? Math.max(0, Math.min(760 - H, cy - H / 2)) : cy - H / 2;
const vb = [x0, y0, W, H].map(Math.round).join(' ');
const size = W;
const k = size / 420; // marker scale, so small maps keep readable dots and names
---
<div class="mm" aria-hidden="true">
  <svg viewBox={vb} preserveAspectRatio="xMidYMid meet">
    <image class="lt" href="/map/china.svg" width="760" height="760" />
    <image class="dk" href="/map/china-dark.svg" width="760" height="760" />
    {lines.map((l) => <path d={l.d} fill="none" stroke={color[l.m]} stroke-width="3" stroke-linecap="round" stroke-dasharray={dash[l.m]} vector-effect="non-scaling-stroke" />)}
    {stops.map((id) => {
      const c = C[id].map;
      return (
        <g transform={`translate(${c.x} ${c.y}) scale(${k.toFixed(2)})`}>
          <circle r="6" fill="#fff" stroke="#34483E" stroke-width="2.5" />
          <text x={c.dx} y={c.dy + 4} text-anchor={c.anchor} class="ml">{C[id].name}</text>
        </g>
      );
    })}
  </svg>
</div>
<style>
  .mm { aspect-ratio: 4 / 3; overflow: hidden; border-radius: 14px; background: #F3F0E8; }
  .mm svg { width: 100%; height: 100%; }
  .ml { font: 700 12px var(--f-body); fill: #343A36; paint-order: stroke; stroke: #F3F0E8; stroke-width: 3px; }
  .dk { display: none; }
  @media (prefers-color-scheme: dark) { .mm { background: #2B322D; } .lt { display: none; } .dk { display: inline; } .ml { fill: #E7EAE6; stroke: #1F2521; } }
</style>
